# Server environment variables
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file that contains secrets.

# MongoDB Atlas connection string (server-only, never NEXT_PUBLIC_*)
# Example shape (do not put a real password here):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/wayfleet?appName=wayfleet
MONGODB_URI=

# Auth.js (required for sign-in)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (optional — leave empty until you create a Google Cloud OAuth client)
# Without these, email/password still works. The Google button stays disabled.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# APP_ENV=development

# Razorpay (server-only). Never prefix KEY_SECRET with NEXT_PUBLIC_.
# The public key is returned by POST /api/payments/create-order, not exposed as NEXT_PUBLIC_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard webhook secret. Used only by POST /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Google Maps JavaScript + Places (browser). Restrict this key by HTTP referrer.
# Never put a server-only Google secret on NEXT_PUBLIC_*.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Reserved for future server-side Geocoding/Directions. Unused in Milestone 9.
GOOGLE_MAPS_API_KEY=

# Socket.IO realtime process (separate from Next.js). Restrict CORS on the host.
# Browser URL of the long-lived realtime server. Never put REALTIME_SERVER_SECRET here.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
# Optional dedicated HMAC secret for realtime tokens. Falls back to AUTH_SECRET.
REALTIME_SERVER_SECRET=
# REALTIME_PORT=4001
# Extra CORS origins (comma-separated) in addition to AUTH_URL and localhost:3000
# REALTIME_CORS_ORIGIN=
# Optional GPS publish interval override (1000-60000 ms). Default 5000.
# TRACKING_MIN_INTERVAL_MS=5000
